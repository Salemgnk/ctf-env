#compdef ctf
# Complétion zsh pour ctf.
_ctf() {
  if (( CURRENT == 2 )); then
    local -a cmds
    cmds=(${(f)"$(ctf _complete commands 2>/dev/null)"})
    _describe 'commande' cmds
    return
  fi
  case "${words[2]}" in
    use)
      local -a chals
      chals=(${(f)"$(ctf _complete challenges 2>/dev/null)"})
      _describe 'challenge' chals
      ;;
    vpn)
      local -a v
      v=(${(f)"$(ctf _complete vpn 2>/dev/null)"})
      _describe 'vpn' v
      ;;
  esac
}
_ctf "$@"

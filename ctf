#!/usr/bin/env python3
"""ctf : ranger les challenges CTF et HTB, y déposer les téléchargements, se connecter au VPN.

Usage :
  ctf                          où on en est : challenge en cours, VPN, rangement
  ctf new <groupe>/<nom> [ip]  crée le challenge et le met en cours (ex. ctf new htb/cicada 10.10.11.35)
  ctf use <groupe>/<nom>       reprend un challenge existant
  ctf off                      plus de challenge en cours
  ctf ls                       liste des challenges, les plus récents d'abord
  ctf path                     chemin du challenge en cours (utilisé par cdc)
  ctf vpn [nom]                connexion au VPN avec un fichier .ovpn
  ctf vpn add <fichier.ovpn>   ajoute un fichier VPN
  ctf vpn stop                 coupe le VPN
  ctf watch                    range les téléchargements (lancé par le service ctf-downloads)

Tant qu'un challenge est en cours, chaque nouveau fichier de ~/Downloads est
déplacé dans son dossier fichiers/. Les .ovpn vont dans ~/.config/ctf/vpn/.
"""
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

NAME = re.compile(r"^[a-z0-9][a-z0-9-]*$")
CURRENT = ".courant"
NOTES = """# {group}/{name}

Créé le {date}.

## Cible

- IP : {ip}
- Nom d'hôte :

## Ports et services

## Identifiants

## Étapes

## Flags

- user :
- root :
"""


def downloads_default():
    try:
        r = subprocess.run(["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True, timeout=5)
        d = r.stdout.strip()
        if r.returncode == 0 and d and d != str(Path.home()):
            return Path(d)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / "Downloads"


def paths():
    env, home = os.environ, Path.home()
    return {
        "root": Path(env.get("CTF_ROOT") or home / "Documents" / "ctf"),
        "config": Path(env.get("CTF_CONFIG") or home / ".config" / "ctf"),
        "cache": Path(env.get("CTF_CACHE") or home / ".cache" / "ctf"),
        "downloads": Path(env["CTF_DOWNLOADS"]) if env.get("CTF_DOWNLOADS") else downloads_default(),
    }


def err(msg):
    print(msg, file=sys.stderr)


# ---------- challenges ----------

def parse_name(s):
    parts = s.strip().split("/")
    if len(parts) != 2 or not all(NAME.match(p) for p in parts):
        raise ValueError(
            f"Nom invalide : « {s} ». Attendu groupe/nom, en minuscules, chiffres et tirets "
            "(ex. htb/cicada ou epihack-2026/obsidian-key)."
        )
    return parts[0], parts[1]


def challenge_dir(name):
    group, nom = parse_name(name)
    return paths()["root"] / group / nom


def label(d):
    return f"{d.parent.name}/{d.name}"


def current():
    link = paths()["root"] / CURRENT
    if not link.is_symlink():
        return None
    target = Path(os.readlink(link))
    if not target.is_absolute():
        target = link.parent / target
    return target if target.is_dir() else None


def broken_current():
    """Chemin visé par un lien .courant dont le dossier a disparu, sinon None."""
    link = paths()["root"] / CURRENT
    if link.is_symlink() and current() is None:
        return Path(os.readlink(link))
    return None


def set_current(d):
    root = paths()["root"]
    root.mkdir(parents=True, exist_ok=True)
    tmp = root / f".courant.{os.getpid()}.tmp"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    os.symlink(d, tmp)
    os.replace(tmp, root / CURRENT)


def challenge_new(name, ip=None):
    d = challenge_dir(name)
    for sub in ("fichiers", "scans"):
        (d / sub).mkdir(parents=True, exist_ok=True)
    notes = d / "notes.md"
    if not notes.exists():
        notes.write_text(NOTES.format(group=d.parent.name, name=d.name,
                                      date=datetime.now().strftime("%d/%m/%Y"), ip=ip or ""),
                         encoding="utf-8")
    set_current(d)
    return d


def challenge_use(name):
    d = challenge_dir(name)
    if not (d / "notes.md").is_file():
        raise ValueError(f"Le challenge {name} n'existe pas. Pour le créer : ctf new {name}")
    set_current(d)
    return d


def challenge_off():
    link = paths()["root"] / CURRENT
    if link.is_symlink():
        link.unlink()


def challenges():
    root = paths()["root"]
    found = [n.parent for n in root.glob("*/*/notes.md") if n.parent.is_dir() and not n.parent.parent.name.startswith(".")]
    return sorted(found, key=lambda d: (d / "notes.md").stat().st_mtime, reverse=True)


# ---------- téléchargements ----------

PARTIAL = (".crdownload", ".part", ".tmp", ".download")
STABLE = 2.0  # secondes sans changement de taille avant de déplacer


def free_name(directory, name):
    """Chemin libre dans directory : a.zip, sinon a (2).zip, a (3).zip..."""
    p = directory / name
    stem, suffix = Path(name).stem, Path(name).suffix
    n = 2
    while p.exists() or p.is_symlink():
        p = directory / f"{stem} ({n}){suffix}"
        n += 1
    return p


class Watcher:
    """Déplace les nouveaux fichiers du dossier de téléchargements.

    Les fichiers présents au démarrage, et ceux arrivés sans challenge en
    cours, ne sont jamais déplacés. Les .ovpn vont toujours dans le dossier VPN.
    """

    def __init__(self, now):
        self.dl = paths()["downloads"]
        self.seen = set(self.names())
        self.pending = {}  # nom -> (taille, depuis)

    def names(self):
        try:
            return [e.name for e in os.scandir(self.dl)
                    if not e.name.startswith(".") and not e.name.endswith(PARTIAL) and e.is_file()]
        except OSError:
            return []

    def tick(self, now):
        present = self.names()
        live = set(present)
        self.seen &= live
        self.pending = {k: v for k, v in self.pending.items() if k in live}
        moves = []
        for name in present:
            if name in self.seen:
                continue
            if any((self.dl / (name + suf)).exists() for suf in PARTIAL):
                # Firefox laisse un fichier vide au nom final tant que le .part existe
                self.pending.pop(name, None)
                continue
            src = self.dl / name
            try:
                size = src.stat().st_size
            except OSError:
                continue
            old = self.pending.get(name)
            if old is None or old[0] != size:
                self.pending[name] = (size, now)
                continue
            if now - old[1] < STABLE:
                continue
            del self.pending[name]
            if name.lower().endswith(".ovpn"):
                target_dir = paths()["config"] / "vpn"
            else:
                cur = current()
                if cur is None:
                    self.seen.add(name)
                    continue
                target_dir = cur / "fichiers"
            try:
                target_dir.mkdir(parents=True, exist_ok=True)
                dst = free_name(target_dir, name)
                shutil.move(str(src), str(dst))
            except OSError as e:
                err(f"Impossible de déplacer {name} : {e}")
                self.seen.add(name)
                continue
            moves.append((src, dst))
        return moves


def notify(moves):
    for src, dst in moves:
        if dst.parent == paths()["config"] / "vpn":
            msg = f"{dst.name} ajouté aux fichiers VPN (ctf vpn)"
        else:
            msg = f"{dst.name} rangé dans {label(dst.parent.parent)}"
        print(msg, flush=True)
        try:
            subprocess.run(["notify-send", "-a", "ctf", "Téléchargement rangé", msg],
                           capture_output=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            pass


def watch():
    w = Watcher(time.monotonic())
    print(f"Surveillance de {w.dl}", flush=True)
    try:
        while True:
            notify(w.tick(time.monotonic()))
            time.sleep(1)
    except KeyboardInterrupt:
        return 0


# ---------- VPN ----------

NO_VPN = (
    "Aucun fichier VPN pour l'instant.\n"
    "Sur HTB : bouton « Connect to HTB » en haut à droite, choisis le type (Machines, Starting Point...)\n"
    "puis OpenVPN et télécharge le Connection Pack (.ovpn).\n"
    "S'il arrive dans ~/Downloads, il est rangé tout seul ; sinon : ctf vpn add <fichier.ovpn>"
)


def vpn_dir():
    return paths()["config"] / "vpn"


def vpn_files():
    d = vpn_dir()
    return sorted(p for p in d.glob("*.ovpn") if p.is_file()) if d.is_dir() else []


def vpn_add(src):
    src = Path(src).expanduser()
    if not src.is_file():
        raise ValueError(f"Fichier introuvable : {src}")
    if src.suffix.lower() != ".ovpn":
        raise ValueError(f"Ce n'est pas un fichier .ovpn : {src}")
    vpn_dir().mkdir(parents=True, exist_ok=True)
    dst = free_name(vpn_dir(), src.name)
    shutil.copy2(src, dst)
    os.chmod(dst, 0o600)
    return dst


def pid_file():
    return paths()["cache"] / "vpn.pid"


def proc_name(pid):
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return None


def vpn_running():
    """PID d'openvpn lancé par ctf, ou None. Le fichier PID appartient à root et peut
    rester après la fin d'openvpn : on vérifie que le processus est bien openvpn, pour
    ne jamais tuer un autre programme qui aurait récupéré ce numéro."""
    try:
        pid = int(pid_file().read_text().strip())
    except (OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except PermissionError:  # openvpn tourne en root
        pass
    except (OSError, OverflowError):
        return None
    return pid if proc_name(pid) == "openvpn" else None


def pick_vpn(name):
    files = vpn_files()
    if not files:
        raise ValueError(NO_VPN)
    if name:
        for f in files:
            if name in (f.name, f.stem):
                return f
        raise ValueError(f"Pas de fichier VPN « {name} ». Disponibles : " + ", ".join(f.stem for f in files))
    if len(files) > 1:
        raise ValueError("Plusieurs fichiers VPN, précise lequel :\n" + "\n".join(f"  ctf vpn {f.stem}" for f in files))
    return files[0]


def log_tail(n=8):
    try:
        return "\n".join((paths()["cache"] / "vpn.log").read_text(errors="replace").splitlines()[-n:])
    except OSError:
        return f"(journal illisible : sudo tail {paths()['cache'] / 'vpn.log'})"


def vpn_start(name=None):
    pid = vpn_running()
    if pid:
        ip = tun_ip()
        print(f"Le VPN tourne déjà (openvpn {pid})" + (f", ton IP est {ip}" if ip else "") + ". ctf vpn stop pour le couper.")
        return 0
    conf = pick_vpn(name)
    cache = paths()["cache"]
    cache.mkdir(parents=True, exist_ok=True)
    print(f"Connexion avec {conf.name} (mot de passe sudo demandé)...")
    r = subprocess.run(["sudo", "openvpn", "--config", str(conf), "--daemon",
                        "--writepid", str(pid_file()), "--log", str(cache / "vpn.log")])
    if r.returncode:
        err("openvpn n'a pas pu démarrer.")
        return 1
    for _ in range(30):  # 15 s
        ip = tun_ip()
        if ip:
            print(f"VPN connecté, ton IP est {ip}")
            return 0
        time.sleep(0.5)
    err("Le VPN ne s'est pas connecté en 15 s. Fin du journal :")
    err(log_tail())
    return 1


def vpn_stop():
    pid = vpn_running()
    if not pid:
        print("Aucune connexion VPN lancée par ctf.")
        return 0
    r = subprocess.run(["sudo", "kill", str(pid)])
    if r.returncode:
        err(f"Impossible d'arrêter openvpn ({pid}).")
        return 1
    print("VPN coupé.")
    return 0


# ---------- état ----------

def tun_ip():
    try:
        r = subprocess.run(["ip", "-4", "-o", "addr", "show", "tun0"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", r.stdout)
    return m.group(1) if m else None


def service_state():
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", "ctf-downloads"],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return "inconnu"
    return "actif" if r.stdout.strip() == "active" else "arrêté"


def status():
    cur, gone = current(), broken_current()
    if cur:
        print(f"Challenge en cours : {label(cur)}")
        print(f"  {cur}")
    elif gone:
        print(f"Le challenge en cours n'existe plus : {gone}")
        print("  ctf use <groupe>/<nom> pour en choisir un autre, ou ctf off.")
    else:
        print("Aucun challenge en cours. ctf new <groupe>/<nom> pour en commencer un.")
    ip = tun_ip()
    print(f"VPN : connecté, ton IP est {ip}" if ip else "VPN : non connecté (ctf vpn)")
    state = service_state()
    where = f"vers {label(cur)}/fichiers" if cur else "en pause, aucun challenge en cours"
    print(f"Rangement des téléchargements : {state}, {where}" if state == "actif"
          else f"Rangement des téléchargements : {state} (systemctl --user start ctf-downloads)")
    return 0


# ---------- commandes ----------

def usage(code):
    print(__doc__.strip(), file=sys.stdout if code == 0 else sys.stderr)
    return code


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])
    try:
        if cmd in ("-h", "--help", "help"):
            return usage(0)
        if not cmd:
            return status()
        if cmd == "new" and 1 <= len(args) <= 2:
            d = challenge_new(args[0], args[1] if len(args) == 2 else None)
            print(f"Challenge en cours : {label(d)}\n  {d}\nLes téléchargements arriveront dans {d / 'fichiers'}")
            return 0
        if cmd == "use" and len(args) == 1:
            d = challenge_use(args[0])
            print(f"Challenge en cours : {label(d)}\n  {d}")
            return 0
        if cmd == "off" and not args:
            challenge_off()
            print("Plus de challenge en cours : les téléchargements restent dans ~/Downloads.")
            return 0
        if cmd == "path" and not args:
            cur = current()
            if not cur:
                err("Aucun challenge en cours.")
                return 1
            print(cur)
            return 0
        if cmd == "vpn":
            if args[:1] == ["stop"] and len(args) == 1:
                return vpn_stop()
            if args[:1] == ["add"] and len(args) == 2:
                dst = vpn_add(args[1])
                print(f"Fichier VPN ajouté : {dst.stem}. Connexion : ctf vpn {dst.stem if len(vpn_files()) > 1 else ''}".rstrip())
                return 0
            if len(args) <= 1:
                return vpn_start(args[0] if args else None)
        if cmd == "watch" and not args:
            return watch()
        if cmd == "ls" and not args:
            cur = current()
            for d in challenges():
                mark = "*" if d == cur else " "
                when = datetime.fromtimestamp((d / "notes.md").stat().st_mtime).strftime("%d/%m/%Y")
                print(f"{mark} {when}  {label(d)}")
            return 0
    except ValueError as e:
        err(str(e))
        return 1
    return usage(2)


if __name__ == "__main__":
    sys.exit(main())

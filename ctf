#!/usr/bin/env python3
"""ctf : ranger les challenges CTF et HTB, y déposer les téléchargements, se connecter au VPN.

Usage :
  ctf                          où on en est : challenge en cours, VPN, rangement
  ctf new <groupe>/<nom> [ip]  crée le challenge et le met en cours (ex. ctf new htb/cicada 10.10.11.35)
  ctf use <groupe>/<nom>       reprend un challenge existant
  ctf off                      plus de challenge en cours
  ctf ls                       liste des challenges, les plus récents d'abord
  ctf path                     chemin du challenge en cours (utilisé par cdc)
  ctf ip [adresse]             lire ou changer l'IP cible du challenge
  ctf flag [user|root|<nom>] <valeur>   enregistrer un flag
  ctf note <texte>             ajouter une note horodatée au journal
  ctf scan                     nmap -sC -sV sur l'IP, rangé dans scans/, puis pistes
  ctf vpn [nom]                connexion au VPN avec un fichier .ovpn
  ctf vpn add <fichier.ovpn>   ajoute un fichier VPN
  ctf vpn stop                 coupe le VPN
  ctf watch                    range les téléchargements (lancé par le service ctf-downloads)

Tant qu'un challenge est en cours, chaque nouveau fichier de ~/Downloads est
déplacé dans son dossier fichiers/. Les .ovpn vont dans ~/.config/ctf/vpn/.
"""
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

NAME = re.compile(r"^[a-z0-9][a-z0-9-]*$")
CURRENT = ".courant"
NOTES = """# {group}/{name}

Créé le {date}.

## Cible

- IP : {ip}
- Nom d'hôte :

## Ports et services

## Identifiants

## Étapes

## Flags

- user :
- root :
"""


def downloads_default():
    try:
        r = subprocess.run(["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True, timeout=5)
        d = r.stdout.strip()
        if r.returncode == 0 and d and d != str(Path.home()):
            return Path(d)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / "Downloads"


def paths():
    env, home = os.environ, Path.home()
    return {
        "root": Path(env.get("CTF_ROOT") or home / "Documents" / "ctf"),
        "config": Path(env.get("CTF_CONFIG") or home / ".config" / "ctf"),
        "cache": Path(env.get("CTF_CACHE") or home / ".cache" / "ctf"),
        "downloads": Path(env["CTF_DOWNLOADS"]) if env.get("CTF_DOWNLOADS") else downloads_default(),
    }


def err(msg):
    print(msg, file=sys.stderr)


# ---------- challenges ----------

def parse_name(s):
    parts = s.strip().split("/")
    if len(parts) != 2 or not all(NAME.match(p) for p in parts):
        raise ValueError(
            f"Nom invalide : « {s} ». Attendu groupe/nom, en minuscules, chiffres et tirets "
            "(ex. htb/cicada ou epihack-2026/obsidian-key)."
        )
    return parts[0], parts[1]


def challenge_dir(name):
    group, nom = parse_name(name)
    return paths()["root"] / group / nom


def label(d):
    return f"{d.parent.name}/{d.name}"


def current():
    link = paths()["root"] / CURRENT
    if not link.is_symlink():
        return None
    target = Path(os.readlink(link))
    if not target.is_absolute():
        target = link.parent / target
    return target if target.is_dir() else None


def broken_current():
    """Chemin visé par un lien .courant dont le dossier a disparu, sinon None."""
    link = paths()["root"] / CURRENT
    if link.is_symlink() and current() is None:
        return Path(os.readlink(link))
    return None


def set_current(d):
    root = paths()["root"]
    root.mkdir(parents=True, exist_ok=True)
    tmp = root / f".courant.{os.getpid()}.tmp"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    os.symlink(d, tmp)
    os.replace(tmp, root / CURRENT)


def challenge_new(name, ip=None):
    d = challenge_dir(name)
    for sub in ("fichiers", "scans"):
        (d / sub).mkdir(parents=True, exist_ok=True)
    notes = d / "notes.md"
    if not notes.exists():
        notes.write_text(NOTES.format(group=d.parent.name, name=d.name,
                                      date=datetime.now().strftime("%d/%m/%Y"), ip=ip or ""),
                         encoding="utf-8")
    set_current(d)
    return d


def challenge_use(name):
    d = challenge_dir(name)
    if not (d / "notes.md").is_file():
        raise ValueError(f"Le challenge {name} n'existe pas. Pour le créer : ctf new {name}")
    set_current(d)
    return d


def challenge_off():
    link = paths()["root"] / CURRENT
    if link.is_symlink():
        link.unlink()


def challenges():
    root = paths()["root"]
    found = [n.parent for n in root.glob("*/*/notes.md") if n.parent.is_dir() and not n.parent.parent.name.startswith(".")]
    return sorted(found, key=lambda d: (d / "notes.md").stat().st_mtime, reverse=True)


# ---------- téléchargements ----------

PARTIAL = (".crdownload", ".part", ".tmp", ".download")
STABLE = 2.0  # secondes sans changement de taille avant de déplacer


def free_name(directory, name):
    """Chemin libre dans directory : a.zip, sinon a (2).zip, a (3).zip..."""
    p = directory / name
    stem, suffix = Path(name).stem, Path(name).suffix
    n = 2
    while p.exists() or p.is_symlink():
        p = directory / f"{stem} ({n}){suffix}"
        n += 1
    return p


class Watcher:
    """Déplace les nouveaux fichiers du dossier de téléchargements.

    Les fichiers présents au démarrage, et ceux arrivés sans challenge en
    cours, ne sont jamais déplacés. Les .ovpn vont toujours dans le dossier VPN.
    """

    def __init__(self, now):
        self.dl = paths()["downloads"]
        self.seen = set(self.names())
        self.pending = {}  # nom -> (taille, depuis)

    def names(self):
        try:
            return [e.name for e in os.scandir(self.dl)
                    if not e.name.startswith(".") and not e.name.endswith(PARTIAL) and e.is_file()]
        except OSError:
            return []

    def tick(self, now):
        present = self.names()
        live = set(present)
        self.seen &= live
        self.pending = {k: v for k, v in self.pending.items() if k in live}
        moves = []
        for name in present:
            if name in self.seen:
                continue
            if any((self.dl / (name + suf)).exists() for suf in PARTIAL):
                # Firefox laisse un fichier vide au nom final tant que le .part existe
                self.pending.pop(name, None)
                continue
            src = self.dl / name
            try:
                size = src.stat().st_size
            except OSError:
                continue
            old = self.pending.get(name)
            if old is None or old[0] != size:
                self.pending[name] = (size, now)
                continue
            if now - old[1] < STABLE:
                continue
            del self.pending[name]
            if name.lower().endswith(".ovpn"):
                target_dir = paths()["config"] / "vpn"
            else:
                cur = current()
                if cur is None:
                    self.seen.add(name)
                    continue
                target_dir = cur / "fichiers"
            try:
                target_dir.mkdir(parents=True, exist_ok=True)
                dst = free_name(target_dir, name)
                shutil.move(str(src), str(dst))
            except OSError as e:
                err(f"Impossible de déplacer {name} : {e}")
                self.seen.add(name)
                continue
            moves.append((src, dst))
        return moves


def describe_move(dst):
    if dst.parent == paths()["config"] / "vpn":
        return f"{dst.name} ajouté aux fichiers VPN (ctf vpn)"
    if dst.parent.name == "fichiers":
        try:
            res = triage(dst)
            return f"{dst.name} rangé dans {label(dst.parent.parent)} [{res['category']}]"
        except Exception as e:  # le rangement reste fiable même si un outil casse
            err(f"Tri de {dst.name} impossible : {e}")
    return f"{dst.name} rangé dans {label(dst.parent.parent)}"


def send(title, msg):
    print(msg, flush=True)
    try:
        subprocess.run(["notify-send", "-a", "ctf", title, msg], capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def notify(moves):
    for _, dst in moves:
        send("Téléchargement rangé", describe_move(dst))


def watch():
    w = Watcher(time.monotonic())
    print(f"Surveillance de {w.dl}", flush=True)
    try:
        while True:
            notify(w.tick(time.monotonic()))
            for h in new_hints(current()):
                send("Piste CTF", h)
            time.sleep(1)
    except KeyboardInterrupt:
        return 0


# ---------- VPN ----------

NO_VPN = (
    "Aucun fichier VPN pour l'instant.\n"
    "Sur HTB : bouton « Connect to HTB » en haut à droite, choisis le type (Machines, Starting Point...)\n"
    "puis OpenVPN et télécharge le Connection Pack (.ovpn).\n"
    "S'il arrive dans ~/Downloads, il est rangé tout seul ; sinon : ctf vpn add <fichier.ovpn>"
)


def vpn_dir():
    return paths()["config"] / "vpn"


def vpn_files():
    d = vpn_dir()
    return sorted(p for p in d.glob("*.ovpn") if p.is_file()) if d.is_dir() else []


def vpn_add(src):
    src = Path(src).expanduser()
    if not src.is_file():
        raise ValueError(f"Fichier introuvable : {src}")
    if src.suffix.lower() != ".ovpn":
        raise ValueError(f"Ce n'est pas un fichier .ovpn : {src}")
    vpn_dir().mkdir(parents=True, exist_ok=True)
    dst = free_name(vpn_dir(), src.name)
    shutil.copy2(src, dst)
    os.chmod(dst, 0o600)
    return dst


def pid_file():
    return paths()["cache"] / "vpn.pid"


def proc_name(pid):
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return None


def vpn_running():
    """PID d'openvpn lancé par ctf, ou None. Le fichier PID appartient à root et peut
    rester après la fin d'openvpn : on vérifie que le processus est bien openvpn, pour
    ne jamais tuer un autre programme qui aurait récupéré ce numéro."""
    try:
        pid = int(pid_file().read_text().strip())
    except (OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except PermissionError:  # openvpn tourne en root
        pass
    except (OSError, OverflowError):
        return None
    return pid if proc_name(pid) == "openvpn" else None


def pick_vpn(name):
    files = vpn_files()
    if not files:
        raise ValueError(NO_VPN)
    if name:
        for f in files:
            if name in (f.name, f.stem):
                return f
        raise ValueError(f"Pas de fichier VPN « {name} ». Disponibles : " + ", ".join(f.stem for f in files))
    if len(files) > 1:
        raise ValueError("Plusieurs fichiers VPN, précise lequel :\n" + "\n".join(f"  ctf vpn {f.stem}" for f in files))
    return files[0]


def log_tail(n=8):
    try:
        return "\n".join((paths()["cache"] / "vpn.log").read_text(errors="replace").splitlines()[-n:])
    except OSError:
        return f"(journal illisible : sudo tail {paths()['cache'] / 'vpn.log'})"


def vpn_start(name=None):
    pid = vpn_running()
    if pid:
        ip = tun_ip()
        print(f"Le VPN tourne déjà (openvpn {pid})" + (f", ton IP est {ip}" if ip else "") + ". ctf vpn stop pour le couper.")
        return 0
    conf = pick_vpn(name)
    cache = paths()["cache"]
    cache.mkdir(parents=True, exist_ok=True)
    print(f"Connexion avec {conf.name} (mot de passe sudo demandé)...")
    r = subprocess.run(["sudo", "openvpn", "--config", str(conf), "--daemon",
                        "--writepid", str(pid_file()), "--log", str(cache / "vpn.log")])
    if r.returncode:
        err("openvpn n'a pas pu démarrer.")
        return 1
    for _ in range(30):  # 15 s
        ip = tun_ip()
        if ip:
            print(f"VPN connecté, ton IP est {ip}")
            return 0
        time.sleep(0.5)
    err("Le VPN ne s'est pas connecté en 15 s. Fin du journal :")
    err(log_tail())
    return 1


def vpn_stop():
    pid = vpn_running()
    if not pid:
        print("Aucune connexion VPN lancée par ctf.")
        return 0
    r = subprocess.run(["sudo", "kill", str(pid)])
    if r.returncode:
        err(f"Impossible d'arrêter openvpn ({pid}).")
        return 1
    print("VPN coupé.")
    return 0


# ---------- tri des artefacts ----------

KINDS = {
    "image": {"png", "jpg", "jpeg", "gif", "bmp", "webp", "tiff", "tif", "svg", "ico"},
    "audio": {"wav", "mp3", "flac", "ogg", "m4a"},
    "video": {"mp4", "avi", "mkv", "mov", "webm"},
    "pcap": {"pcap", "pcapng", "cap"},
    "archive": {"zip", "tar", "gz", "tgz", "bz2", "xz", "7z", "rar", "zst"},
    "pdf": {"pdf"},
    "office": {"doc", "docx", "xls", "xlsx", "ppt", "pptx", "rtf", "odt"},
    "elf": {"elf", "so", "o", "bin"},
    "pe": {"exe", "dll", "msi"},
    "apk": {"apk"},
    "jar": {"jar", "class"},
    "forensic-image": {"raw", "mem", "vmem", "dd", "img", "e01", "lime", "dmp", "vhd", "ad1"},
    "crypto": {"pem", "key", "enc", "cipher", "gpg"},
    "source": {"py", "js", "php", "rb", "c", "cpp", "go", "java", "sh"},
    "text": {"txt", "md", "log", "json", "csv", "xml", "yaml", "yml"},
}
CATEGORY = {
    "image": "stégano", "audio": "stégano", "video": "stégano",
    "pcap": "forensic-réseau", "forensic-image": "forensic",
    "elf": "reverse", "pe": "reverse", "apk": "reverse", "jar": "reverse",
    "pdf": "forensic", "office": "forensic", "crypto": "crypto",
    "archive": "misc", "source": "misc", "text": "misc", "data": "misc",
}
TOOL_CAP = 6000  # caractères gardés par commande


def file_desc(path):
    try:
        r = subprocess.run(["file", "-b", str(path)], capture_output=True, text=True, timeout=15)
        return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def file_kind(path):
    ext = Path(path).suffix.lower().lstrip(".")
    for kind, exts in KINDS.items():
        if ext in exts:
            return kind
    desc = file_desc(path)
    table = [("ELF", "elf"), ("PE32", "pe"), ("MS-DOS", "pe"), ("PNG image", "image"),
             ("JPEG", "image"), ("image data", "image"), ("pcap", "pcap"), ("PDF", "pdf"),
             ("gzip", "archive"), ("Zip archive", "archive"), ("tar archive", "archive"),
             ("Audio", "audio"), ("ASCII", "text"), ("Unicode text", "text")]
    for needle, kind in table:
        if needle in desc:
            return kind
    return "data"


def category_for(kind):
    return CATEGORY.get(kind, "misc")


def triage_commands(path, kind):
    p, ext = str(path), Path(path).suffix.lower().lstrip(".")
    if kind in ("image", "audio", "video"):
        cmds = [["exiftool", p], ["binwalk", p]]
        if ext in ("png", "bmp"):
            cmds.append(["zsteg", "-a", p])
        return cmds
    if kind in ("elf", "pe"):
        return [["file", p], ["checksec", "--file", p], ["strings", "-n", "8", p]]
    if kind in ("apk", "jar"):
        return [["file", p], ["unzip", "-l", p]]
    if kind == "pcap":
        return [["capinfos", p], ["tshark", "-r", p, "-q", "-z", "io,phs"]]
    if kind == "archive":
        return [["7z", "l", p]]
    if kind == "pdf":
        return [["exiftool", p], ["pdftotext", p, "-"]]
    if kind == "office":
        return [["exiftool", p], ["olevba", p]]
    if kind == "forensic-image":
        return [["file", p]]
    return [["file", p], ["strings", "-n", "8", p]]


def run_tool(cmd, timeout=90):
    if shutil.which(cmd[0]) is None:
        return f"[{cmd[0]} non installé]"
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=timeout)
    except subprocess.TimeoutExpired:
        return f"[{cmd[0]} : délai dépassé]"
    except OSError as e:
        return f"[{cmd[0]} : {e}]"
    out = (r.stdout or "") + (r.stderr or "")
    return out[:TOOL_CAP] + ("\n[... tronqué]" if len(out) > TOOL_CAP else "")


def challenge_category(d):
    f = d / ".categorie"
    return f.read_text().strip() if f.is_file() else None


def set_category(d, cat):
    (d / ".categorie").write_text(cat + "\n", encoding="utf-8")


def append_section(notes, header, line):
    """Ajoute line sous header dans notes.md, en créant la section au besoin, sans doublon."""
    text = notes.read_text(encoding="utf-8") if notes.exists() else ""
    if line in text:
        return
    if header in text:
        parts = text.split(header, 1)
        rest = parts[1].split("\n", 1)
        text = parts[0] + header + rest[0] + "\n" + line + ("\n" + rest[1] if len(rest) > 1 else "\n")
    else:
        text = text.rstrip() + f"\n\n{header}\n\n{line}\n"
    notes.write_text(text, encoding="utf-8")


def triage(path):
    challenge = path.parent.parent
    kind = file_kind(path)
    cat = category_for(kind)
    desc = file_desc(path)
    scans = challenge / "scans"
    scans.mkdir(parents=True, exist_ok=True)
    out = [f"# {path.name}", f"Type : {kind} — catégorie : {cat}", f"file : {desc}", ""]
    for cmd in triage_commands(path, kind):
        out.append(f"$ {' '.join(cmd)}")
        out.append(run_tool(cmd))
        out.append("")
    (scans / f"{path.name}.txt").write_text("\n".join(out), encoding="utf-8")
    if challenge_category(challenge) in (None, "", "misc"):
        set_category(challenge, cat)
    append_section(challenge / "notes.md", "## Artefacts",
                   f"- `{path.name}` — {cat} — {desc} (voir scans/{path.name}.txt)")
    return {"kind": kind, "category": cat, "scan": scans / f"{path.name}.txt"}


# ---------- pistes ----------

ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]|\x1b\][^\x07]*\x07|[\r\x00-\x08\x0b\x0c\x0e\x1f]")


def strip_ansi(s):
    return ANSI.sub("", s)


def hints_from(text):
    hints, seen = [], set()

    def add(h):
        if h not in seen:
            seen.add(h)
            hints.append(h)

    m = re.search(r"[Bb]asic realm[=:]?\s*[\"']?([\w .-]+)", text)
    if m or "401 Unauthorized" in text or "401 UNAUTHORIZED" in text:
        realm = f" (realm {m.group(1).strip()})" if m else ""
        add(f"Un service web est protégé par une authentification HTTP Basic{realm}. "
            "Essaie des identifiants par défaut, puis un brute léger (ffuf/hydra).")
    for host in dict.fromkeys(re.findall(r"\b([a-z0-9][a-z0-9.-]*\.htb)\b", text)):
        add(f"Ajoute « {host} » à /etc/hosts (nom .htb repéré).")
    filt = dict.fromkeys(re.findall(r"(\d+)/tcp\s+filtered", text))
    if filt:
        add(f"Ports filtrés : {', '.join(filt)}. Pare-feu probable ; retente plus tard ou regarde l'UDP.")
    for port in dict.fromkeys(re.findall(r"(\d+)/tcp\s+open\s+http", text)):
        add(f"Service HTTP sur le port {port} : énumère les répertoires (ffuf/gobuster) et les vhosts.")
    return hints


def session_text(d):
    chunks = []
    scans = d / "scans"
    if scans.is_dir():
        for f in sorted(scans.glob("session-*.log")) + sorted(scans.glob("*.nmap")):
            try:
                chunks.append(strip_ansi(f.read_text(errors="replace")))
            except OSError:
                pass
    return "\n".join(chunks)


def new_hints(d):
    if d is None:
        return []
    done_file = d / "scans" / ".pistes.txt"
    done = set(done_file.read_text(encoding="utf-8").splitlines()) if done_file.is_file() else set()
    fresh = [h for h in hints_from(session_text(d)) if h not in done]
    if fresh:
        done_file.parent.mkdir(parents=True, exist_ok=True)
        with open(done_file, "a", encoding="utf-8") as f:
            for h in fresh:
                f.write(h + "\n")
        for h in fresh:
            append_section(d / "notes.md", "## Pistes", f"- {h}")
    return fresh


def challenge_here():
    try:
        cwd = Path.cwd().resolve()
    except OSError:
        return None
    root = paths()["root"].resolve()
    for d in (cwd, *cwd.parents):
        if d.parent.parent == root and (d / "notes.md").is_file():
            return d
    return None


def do_log(target):
    if shutil.which("script") is None:
        err("La commande script (util-linux) est introuvable.")
        return 1
    scans = target / "scans"
    scans.mkdir(parents=True, exist_ok=True)
    log = scans / f"session-{datetime.now().strftime('%Y%m%d-%H%M%S')}.log"
    print(f"Enregistrement dans {log}\nTape « exit » pour arrêter. Pistes poussées pendant ce temps.")
    subprocess.run(["script", "-q", "-a", str(log)])
    for h in new_hints(target):
        print(f"Piste : {h}")
    return 0


# ---------- état ----------

def tun_ip():
    try:
        r = subprocess.run(["ip", "-4", "-o", "addr", "show", "tun0"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", r.stdout)
    return m.group(1) if m else None


def service_state():
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", "ctf-downloads"],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return "inconnu"
    return "actif" if r.stdout.strip() == "active" else "arrêté"


# ---------- champs des notes, flags, journal ----------

FLAG_SLOTS = ("user", "root")
COMMANDS = ("new", "use", "off", "ls", "path", "ip", "flag", "note", "scan",
            "vpn", "log", "hints", "watch")


def active():
    """Le challenge visé : celui du dossier courant, sinon le challenge en cours."""
    return challenge_here() or current()


def read_field(challenge, key):
    try:
        for line in (challenge / "notes.md").read_text(encoding="utf-8").splitlines():
            m = re.match(rf"\s*-\s*{re.escape(key)}\s*:\s*(.*)", line)
            if m:
                return m.group(1).strip()
    except OSError:
        pass
    return ""


def set_field(challenge, key, value, section=None):
    """Remplace la ligne « - key : ... » des notes, ou l'ajoute sous section."""
    notes = challenge / "notes.md"
    try:
        lines = notes.read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
    pat = re.compile(rf"\s*-\s*{re.escape(key)}\s*:.*")
    for i, line in enumerate(lines):
        if pat.fullmatch(line):
            lines[i] = f"- {key} : {value}".rstrip()
            notes.write_text("\n".join(lines) + "\n", encoding="utf-8")
            return
    if section:
        append_section(notes, section, f"- {key} : {value}".rstrip())
    else:
        lines.append(f"- {key} : {value}".rstrip())
        notes.write_text("\n".join(lines) + "\n", encoding="utf-8")


def add_journal(challenge, text):
    stamp = datetime.now().strftime("%H:%M %d/%m")
    append_section(challenge / "notes.md", "## Journal", f"- [{stamp}] {text}")


def scan_args(ip):
    return ["nmap", "-sC", "-sV", ip]


def do_scan():
    cur = active()
    if not cur:
        err("Aucun challenge en cours. ctf new <groupe>/<nom>.")
        return 1
    ip = read_field(cur, "IP")
    if not ip:
        err("Pas d'IP enregistrée pour ce challenge. Fais : ctf ip <adresse>")
        return 1
    if shutil.which("nmap") is None:
        err("nmap est introuvable.")
        return 1
    scans = cur / "scans"
    scans.mkdir(parents=True, exist_ok=True)
    out_file = scans / f"nmap-{datetime.now().strftime('%Y%m%d-%H%M%S')}.txt"
    print(f"nmap -sC -sV {ip} (ça peut prendre une minute)...")
    r = subprocess.run(scan_args(ip), capture_output=True, text=True, errors="replace")
    out_file.write_text((r.stdout or "") + (r.stderr or ""), encoding="utf-8")
    print((r.stdout or "").strip() or "(pas de sortie)")
    hints = new_hints(cur)
    if hints:
        print("\nPistes :")
        for h in hints:
            print(f"- {h}")
    return 0


# ---------- état ----------

def status():
    cur, gone = current(), broken_current()
    if cur:
        print(f"Challenge en cours : {label(cur)}")
        print(f"  {cur}")
        ip = read_field(cur, "IP")
        if ip:
            print(f"  cible : {ip}")
        got = [s for s in FLAG_SLOTS if read_field(cur, s)]
        if got:
            print(f"  flags : {', '.join(got)}")
    elif gone:
        print(f"Le challenge en cours n'existe plus : {gone}")
        print("  ctf use <groupe>/<nom> pour en choisir un autre, ou ctf off.")
    else:
        print("Aucun challenge en cours. ctf new <groupe>/<nom> pour en commencer un.")
    ip = tun_ip()
    print(f"VPN : connecté, ton IP est {ip}" if ip else "VPN : non connecté (ctf vpn)")
    state = service_state()
    where = f"vers {label(cur)}/fichiers" if cur else "en pause, aucun challenge en cours"
    print(f"Rangement des téléchargements : {state}, {where}" if state == "actif"
          else f"Rangement des téléchargements : {state} (systemctl --user start ctf-downloads)")
    return 0


# ---------- commandes ----------

def usage(code):
    print(__doc__.strip(), file=sys.stdout if code == 0 else sys.stderr)
    return code


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])
    try:
        if cmd in ("-h", "--help", "help"):
            return usage(0)
        if not cmd:
            return status()
        if cmd == "new" and 1 <= len(args) <= 2:
            d = challenge_new(args[0], args[1] if len(args) == 2 else None)
            print(f"Challenge en cours : {label(d)}\n  {d}\nLes téléchargements arriveront dans {d / 'fichiers'}")
            return 0
        if cmd == "use" and len(args) == 1:
            d = challenge_use(args[0])
            print(f"Challenge en cours : {label(d)}\n  {d}")
            return 0
        if cmd == "off" and not args:
            challenge_off()
            print("Plus de challenge en cours : les téléchargements restent dans ~/Downloads.")
            return 0
        if cmd == "path" and not args:
            cur = current()
            if not cur:
                err("Aucun challenge en cours.")
                return 1
            print(cur)
            return 0
        if cmd == "vpn":
            if args[:1] == ["stop"] and len(args) == 1:
                return vpn_stop()
            if args[:1] == ["add"] and len(args) == 2:
                dst = vpn_add(args[1])
                print(f"Fichier VPN ajouté : {dst.stem}. Connexion : ctf vpn {dst.stem if len(vpn_files()) > 1 else ''}".rstrip())
                return 0
            if len(args) <= 1:
                return vpn_start(args[0] if args else None)
        if cmd == "_complete" and len(args) >= 1:
            if args[0] == "commands":
                print("\n".join(COMMANDS))
            elif args[0] == "challenges":
                print("\n".join(label(d) for d in challenges()))
            elif args[0] == "vpn":
                print("\n".join(f.stem for f in vpn_files()))
            return 0
        if cmd == "ip" and len(args) <= 1:
            cur = active()
            if not cur:
                err("Aucun challenge en cours. ctf new <groupe>/<nom>.")
                return 1
            if args:
                set_field(cur, "IP", args[0], section="## Cible")
                print(f"IP du challenge : {args[0]}")
            else:
                ip = read_field(cur, "IP")
                print(ip if ip else "Pas d'IP enregistrée. ctf ip <adresse>")
            return 0
        if cmd == "flag" and 1 <= len(args) <= 2:
            cur = active()
            if not cur:
                err("Aucun challenge en cours. ctf new <groupe>/<nom>.")
                return 1
            slot, value = ("flag", args[0]) if len(args) == 1 else (args[0], args[1])
            set_field(cur, slot, value, section="## Flags")
            print(f"Flag {slot} enregistré dans {label(cur)}.")
            return 0
        if cmd == "note" and args:
            cur = active()
            if not cur:
                err("Aucun challenge en cours. ctf new <groupe>/<nom>.")
                return 1
            add_journal(cur, " ".join(args))
            print("Note ajoutée au journal.")
            return 0
        if cmd == "scan" and not args:
            return do_scan()
        if cmd == "watch" and not args:
            return watch()
        if cmd == "ls" and not args:
            cur = current()
            for d in challenges():
                mark = "*" if d == cur else " "
                when = datetime.fromtimestamp((d / "notes.md").stat().st_mtime).strftime("%d/%m/%Y")
                cat = challenge_category(d) or "?"
                print(f"{mark} {when}  {cat:<16} {label(d)}")
            return 0
        if cmd == "log" and not args:
            target = challenge_here() or current()
            if not target:
                err("Aucun challenge où enregistrer. Place-toi dans un challenge ou fais ctf new/use.")
                return 1
            return do_log(target)
        if cmd == "hints" and not args:
            target = challenge_here() or current()
            if not target:
                err("Aucun challenge en cours.")
                return 1
            found = new_hints(target)
            print("\n".join(f"- {h}" for h in hints_from(session_text(target))) or "Aucune piste pour l'instant.")
            return 0
    except ValueError as e:
        err(str(e))
        return 1
    return usage(2)


if __name__ == "__main__":
    sys.exit(main())
